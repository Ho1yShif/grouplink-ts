{
  "name": "grouplink",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Render's links page, rebuilt from Notion by a Render Workflow and served from Key Value by a web service.",
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:web": "tsx --watch src/webhook.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:live": "RUN_LIVE=1 vitest run test/rebuild.live.test.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "placeholder": "tsx scripts/placeholder.ts",
    "preview": "tsx --env-file=.env scripts/preview.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@render-lab/tasks-http": "0.2.0",
    "@render-lab/tasks-notion": "0.5.0",
    "@render-lab/tasks-render-kv": "0.3.0",
    "@render-lab/tasks-scrape": "0.2.0",
    "@render-lab/triggers": "0.2.0",
    "@renderinc/sdk": "1.0.0",
    "hono": "4.13.5",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@render-lab/test-utils": "0.1.0",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.5.1"
}
